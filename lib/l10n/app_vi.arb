  "dmCancelConfirmBody": "Chưa có gì được giao đi cả. Dừng ngay bây giờ thì cả hai điện thoại giữ nguyên như cũ.",
  "dmErrPeerMismatch": "Yêu cầu đó dành cho một danh tính khác. Đã từ chối.",
  "dmErrBadCode": "Các mã không khớp nhau. Không có gì được giao đi.",
  "dmErrHubFailed": "Hub đã từ chối việc giao danh tính ({code}). Không có gì bị thay đổi.",
  "dmErrTimeout": "Điện thoại kia ngừng phản hồi. Không có gì bị thay đổi.",
  "dmErrGeneric": "Đã xảy ra lỗi ({code}).",
  "dmRetryAction": "Thử lại",
  "dmRetryApplyAction": "Hoàn tất cài đặt trên điện thoại này",
  "dmErrSessionTimeout": "Phiên giao danh tính này để không quá lâu nên đã hết hạn. Không có gì được giao đi, nên bạn có thể bắt đầu lại.",
  "dmErrApplyFailed": "Hub đã biến điện thoại này thành nơi giữ duy nhất danh tính đó, nhưng điện thoại này cài khóa mới thất bại. Hãy chạm nút bên dưới để hoàn tất — cho đến lúc đó điện thoại này không dùng được danh tính đó.",
  "dmErrApplyFailedOld": "Máy chủ đã gắn lại danh tính cho điện thoại mới, nhưng điện thoại mới cài khóa mới thất bại. Hãy chạm nút hoàn tất cài đặt trên điện thoại đó; cho đến lúc đó điện thoại này cũng không dùng được danh tính.",
  "dmNotConfigured": "Chưa đặt địa chỉ Hub nên không thể gắn lại danh tính. Hãy đặt nó trong phần Thiết lập trước.",
  "dutyAskTitle": "Để fen của bạn trực chiến?",
  "dutyAskBody": "Với hai quyền này, fen của bạn vẫn làm việc khi màn hình tắt: nó tải tin nhắn, trả lời và đồng bộ hồ sơ công khai — rồi ngủ. Thông báo trực chiến sẽ luôn hiển thị để bạn luôn biết nó đang làm việc. Bạn có thể bỏ qua và vẫn dùng mọi tính năng khi ứng dụng đang mở.",
  "dutyAskConfirm": "Cấp quyền",
  "dutyAskLater": "Để sau",
  "radarAskTitle": "Trước khi bật radar, đây là những gì nó cần",
  "radarAskBody": "Radar vật lý dùng Thiết bị lân cận (Bluetooth / Wi-Fi Direct) để tìm nhau trên cùng một Wi-Fi. Android xếp việc quét Bluetooth vào quyền Vị trí, nên hộp thoại hệ thống cũng hỏi vị trí. Đó là quy tắc của hệ điều hành, không phải ứng dụng này muốn vị trí của bạn.\n\nỨng dụng này không bao giờ đọc, lưu hay tải lên dữ liệu vị trí, và quyền Thiết bị lân cận được khai báo với neverForLocation (hệ điều hành chặn suy ra vị trí từ Bluetooth).\n\nCác hộp thoại quyền hệ thống sẽ hiện tiếp theo. Từ chối không làm thay đổi điều gì khác trong ứng dụng; chỉ là radar sẽ không thấy ai.",
  "dutyDoneToast": "Đã cấp quyền trực chiến. Fen của bạn giờ có thể làm việc khi màn hình tắt.",
  "dutyPartialToast": "Một số quyền chưa được cấp. Fen vẫn làm việc khi ứng dụng mở, nhưng có thể bị hệ thống tạm dừng ở chế độ nền.",
  "romGuideTitle": "Giữ fen của bạn sống sau khi khóa màn hình",
  "romGuideGo": "Mở cài đặt",
  "romGuideDismiss": "Đừng nhắc lại nữa",
  "romStepsXiaomi": "Trên Xiaomi/Redmi (MIUI/HyperOS): 1) Cài đặt → Ứng dụng → Quản lý ứng dụng → 大荒AI → bật Tự khởi động; 2) Ứng dụng Bảo mật → Pin → 大荒AI → Không hạn chế. Không làm những mục này, hệ thống sẽ giết fen trong vài phút sau khi khóa màn hình.",
  "romStepsHuawei": "Trên Huawei (EMUI/HarmonyOS): Cài đặt → Ứng dụng → Quản lý khởi chạy ứng dụng → 大荒AI → tắt Quản lý tự động, rồi bật cả ba: Tự khởi chạy, Khởi chạy phụ, Chạy nền.",
  "romStepsHonor": "Trên Honor (MagicOS): Cài đặt → Ứng dụng → Quản lý khởi chạy ứng dụng → 大荒AI → tắt Quản lý tự động, rồi bật Tự khởi chạy, Khởi chạy phụ và Chạy nền.",
  "romStepsOppo": "Trên OPPO/realme (ColorOS): Cài đặt → Ứng dụng → Quản lý ứng dụng → 大荒AI → cho phép Tự khởi động; Cài đặt → Pin → Cài đặt khác → cho phép 大荒AI hoạt động nền đầy đủ.",
  "romStepsOneplus": "Trên OnePlus: Cài đặt → Ứng dụng → Tự khởi chạy → cho phép 大荒AI; Pin → tối ưu mức dùng pin của 大荒AI thành Không tối ưu.",
  "romStepsVivo": "Trên vivo/iQOO (OriginOS): Cài đặt → Ứng dụng → Quản lý quyền → Tự khởi động, cho phép 大荒AI; Cài đặt → Pin → Tiêu hao pin nền → cho phép 大荒AI tiêu hao nền cao.",
  "romStepsMeizu": "Trên Meizu (Flyme): Trình quản lý điện thoại → Quyền ứng dụng → Quản lý nền → cho phép 大荒AI tiếp tục chạy.",
  "romStepsSamsung": "Trên Samsung (One UI): Cài đặt → Pin → Giới hạn dùng nền → xóa 大荒AI khỏi danh sách ứng dụng ngủ sâu.",
  "romStepsGeneric": "Nếu hệ thống của bạn quyết liệt dừng ứng dụng nền, hãy cho phép 大荒AI tự khởi động và loại nó khỏi tối ưu pin trong cài đặt hệ thống.",
  "helpDotTooltip": "Cách hoạt động",
  "helpSheetClose": "Đã hiểu",
  "helpWorldOverviewTitle": "Phòng khách hoạt động thế nào",
  "helpWorldOverviewBody": "Phòng chính thức mở cho mọi người. Phòng cá nhân chỉ hiện với chủ sở hữu và thành viên: người khác cần đúng số phòng, rồi gửi yêu cầu, rồi chủ phòng phê duyệt. Trong phòng, mỗi tin nhắn gửi đi theo nhịp riêng của phòng (mặc định 8 giây); vượt nhịp đó sẽ bị máy chủ từ chối và bảo bạn chờ một chút.",
  "helpWorldMetricTitle": "Liên kết xuyên vòng tròn trên mỗi người",
  "helpWorldMetricBody": "Phạm vi cục bộ: tử số = các liên kết xuyên vòng tròn của tôi, mẫu số = các fen riêng biệt tôi đã gặp. Bình quân toàn nền tảng cần máy chủ tổng hợp, mà máy chủ cố ý không mang quan hệ vòng tròn.",
  "helpWorldBridgeTitle": "Giới thiệu qua hồ bạn bè",
  "helpWorldBridgeBody": "Người ngoài bạn gặp trong phòng có thể được giới thiệu bằng một chạm. Liên kết xuyên vòng tròn chỉ mọc ra từ phòng: không phòng thì không liên kết.",
  "helpWorldRoomRoleTitle": "Vai trò trong phòng",
  "helpWorldRoomRoleBody": "Vai trò thuộc về phòng và không bao giờ thay đổi danh tính của bạn. Cùng một bạn có thể giữ các vai trò khác nhau ở các phòng khác nhau.",
  "helpIntercardDisclosureTitle": "Thẻ tiết lộ những gì",
  "helpIntercardDisclosureBody": "Chỉ các trường cấp 2 được đưa lên thẻ; những trường chỉ mình bạn thấy thì không bao giờ. Ai cũng có thể tính lại nội dung thẻ.",
  "helpPassportOverviewTitle": "Hộ chiếu là gì",
  "helpPassportOverviewBody": "Hộ chiếu của bạn là một khóa công khai, không phải một tài khoản: nó xác minh ngoại tuyến và không đăng nhập vào máy chủ nào. Chuyển sang điện thoại mới dựa vào mã khôi phục hoặc luân chuyển khóa, không bao giờ dựa vào bộ phận hỗ trợ của nền tảng.",
  "helpPassportOfflineTitle": "Xác minh được ngoại tuyến",
  "helpPassportOfflineBody": "Khóa công khai CHÍNH LÀ danh tính: hộ chiếu này xác minh ngoại tuyến, không cần tra cứu máy chủ.",
  "helpPassportFunnelTitle": "Mẫu số của phễu tính thế nào",
  "helpPassportFunnelBody": "Mẫu số chỉ tính các bản ghi đã chốt; đang xử lý không phải là thất bại. Chỉ những bản ghi mà sự đồng ý đôi bên thực sự xác minh được mới vào mẫu số.",
  "helpPassportReputationTitle": "Vì sao không có điểm tổng toàn cầu",
  "helpPassportReputationBody": "Điểm uy tín toàn cầu sẽ dễ dàng bị làm giả, nên không có. Điều bạn thấy luôn tương đối với các MỎ NEO của BẠN: các chứng thực đã ký, giảm dần theo khoảng cách.\\n\\nNgười quen xã giao không phải điểm khởi đầu cho lan truyền tin cậy — nếu không, việc kết bạn hàng loạt sẽ thổi phồng tầm với của bạn.\\n\\nKhi tra cứu không tìm thấy gì, nó nói \\\"không biết\\\", và đó không phải điểm bằng không: nghĩa là thật sự không biết, và ai biến nó thành một con số thì đang đoán mò.",
  "helpPassportLogTitle": "Nhật ký minh bạch",
  "helpPassportLogBody": "Bạn không cần tin tôi, bạn có thể tự xác minh: ai cũng có thể tải nhật ký, tính lại gốc, và kiểm tra xem bản ghi của mình có bị sửa đổi không.",
  "helpSocialOverviewTitle": "Tab xã hội làm gì",
  "helpSocialOverviewBody": "Danh bạ và bạn bè nằm trên; trạng thái radar và sổ xã hội ở dưới. Radar quyết định tin nhắn có rời đi hay không: khi radar tắt, bấm gửi vẫn không gửi gì ra khỏi điện thoại này.",
  "helpSocialPersonaTierTitle": "Chế độ nhân dạng chuyên biệt",
  "helpSocialPersonaTierBody": "Ổ khóa đánh dấu một chế độ nhân dạng chuyên biệt. Tính phí chưa hoạt động, nên hiện tại mọi chế độ đều chuyển đổi tự do.",
  "helpSocialRadarTitle": "Radar và các kênh",
  "helpSocialRadarBody": "Khi radar tắt, bạn vẫn duyệt được danh bạ, nhưng không có gì rời khỏi điện thoại này: việc gửi bị âm thầm bỏ đi. Hãy bật radar và bật ít nhất một kênh (lân cận / LAN / đám mây).\\n\\nDanh tính có thể xác minh và cố định chỉ xuất hiện sau khi cả hai bên bật radar và hoàn tất một lần bắt tay gần đây.",
  "helpSocialChannelGuideTitle": "Kênh & khắc phục sự cố mạng",
  "helpSocialChannelGuideBody": "1. Khi bật radar vật lý, hãy chắc rằng mạng hiện tại ra được internet.\n2. Khi bật kênh Lân cận, hệ thống có thể tự bật Wi-Fi — đây là nâng cấp đường truyền bình thường (Bluetooth phát hiện, Wi-Fi Direct mang dữ liệu; không tham gia mạng nào). Nó dừng khi tắt kênh Lân cận.\n3. Để tiết kiệm pin khi di chuyển: chỉ dùng kênh Đám mây và tự tắt Wi-Fi (khi bật Lân cận, hệ thống sẽ bật lại Wi-Fi — đúng như dự kiến, không cần mải chống lại nó).",
  "socialRadarOffHint": "Radar đang tắt. Bạn vẫn duyệt được danh bạ, nhưng không có gì rời khỏi điện thoại này: việc gửi bị âm thầm bỏ đi. Hãy bật radar và bật ít nhất một kênh (lân cận / LAN / đám mây) trước khi gửi.",
  "worldRoomCloseAction": "Đóng phòng",
  "worldRoomCloseTitle": "Đóng phòng này?",
  "worldRoomCloseBody": "Sau khi đóng, phòng rời khỏi danh sách công khai và ngừng nhận tin nhắn mới. Cuộc trò chuyện hiện có được giữ làm kho lưu trữ chỉ-đọc mà các thành viên hiện tại vẫn xem lại được.",
  "worldRoomCloseConfirm": "Đóng phòng",
  "worldRoomClosedOk": "{name} giờ đã đóng — một kho lưu trữ chỉ-đọc",
  "worldRoomCloseFailed": "Đóng thất bại: {err}",
  "worldRoomClosedBadge": "Đã đóng",
  "worldRoomClosedReadonlyHint": "Phòng đã đóng — kho lưu trữ chỉ-đọc, không có tin nhắn mới",
  "worldRoomClosedSendRejected": "Phòng này đã đóng; bạn không thể gửi tin nhắn nữa",
  "worldRoomClosedSystemMsg": "Chủ phòng đã đóng phòng này. Giờ nó là một kho lưu trữ chỉ-đọc.",
  "settingsLocalModelSection": "Dự phòng mô hình cục bộ (giảm cấp ngoại tuyến)",
  "settingsLocalModelTest": "Kiểm tra kết nối mô hình cục bộ",
  "settingsLocalModelTesting": "Đang kiểm tra…",
  "settingsLocalModelTestOk": "✅ Đã kết nối: {model} @ {url}",
  "settingsLocalModelTestDisabled": "Dự phòng cục bộ đang tắt (URL trống). Hãy nhập URL và kiểm tra lại nếu bạn muốn dùng nó.",
  "settingsLocalModelTestUnreachable": "❌ Không kết nối được {url}: không có gì đang lắng nghe ở đó (hoặc cổng đã đóng). Trên điện thoại, 127.0.0.1 nghĩa là chính điện thoại, còn máy chủ mô hình thường chạy trên máy tính — hãy kiểm tra địa chỉ và thử lại.",
  "settingsLocalModelTestNotJson": "❌ Có thứ gì đó phản hồi, nhưng không trả về JSON của API mô hình (có thể là proxy hoặc một trang lỗi). Hãy chắc rằng địa chỉ/cổng trỏ tới điểm cuối REST của Ollama / llama.cpp.",
  "settingsLocalModelTestNoMessage": "❌ Điểm cuối có phản hồi, nhưng không đọc được nội dung trả lời (nguyên nhân thường gặp: tên mô hình không tồn tại, hoặc đây không phải phản hồi kiểu /api/chat).",
  "settingsLocalModelTestHttp": "❌ Dịch vụ trả về mã trạng thái {code} (không phải 200).",
  "helpSettingsLocalModelTitle": "Dự phòng mô hình cục bộ: khi nào nó thật sự hoạt động?",
  "helpSettingsLocalModelBody": "Địa chỉ ở đây chỉ là điều bạn bảo ứng dụng dùng — \"đã điền\" không có nghĩa là \"đang chạy\". Trên điện thoại, 127.0.0.1 trỏ vào chính điện thoại, còn máy chủ mô hình (Ollama / llama.cpp) thường chạy trên máy tính, nên mặc định này thường không tới được từ điện thoại. Mục đích thật của nó là: (1) nếu bạn chạy mô hình trên máy tính của mình, hãy nhập địa chỉ LAN của máy đó; (2) khi một bản dựng tương lai có động cơ trên thiết bị, hãy trỏ vào cổng mới.\n\nXóa địa chỉ = chủ động tắt dự phòng cục bộ (ứng dụng ngừng thử mô hình cục bộ).\n\nĐể biết nó có thật sự hoạt động hay không, đừng dựa vào việc ô đã được điền hay chưa — hãy chạm \"Kiểm tra kết nối mô hình cục bộ\" bên dưới: nó gửi một yêu cầu trực tiếp tối thiểu và để kết quả ngay trên dòng đó.",
  "glossaryTitle": "Thuật ngữ",
  "glossaryIntro": "Những từ này lặp lại nhiều lần trong ứng dụng — giải thích một lần ở đây. Chạm vào một thuật ngữ để mở rộng.",
  "glossaryGroupIdentity": "Danh tính & thiết bị",
  "glossaryGroupSocial": "Xã hội & khám phá",
  "glossaryGroupWorld": "Thế giới & phòng khách",
  "glossaryGroupTrust": "Tin cậy & ký ức",
  "glossaryAgentTitle": "Fen (người thay bạn)",
  "glossaryAgentBody": "Người thay bạn sống trên điện thoại của bạn. Nó suy nghĩ bằng khóa mô hình bạn đã nhập và ra ngoài gặp người trước; khi bạn vắng mặt, nó chỉ làm những gì bạn đã cho phép.",
  "glossaryMaskTitle": "Mặt nạ ngoại giao",
  "glossaryMaskBody": "Bộ mặt bạn phô ra thế giới bên ngoài: nhân dạng và phong cách nói của bạn. Nó quyết định điều người lạ thấy về bạn trước tiên.",
  "glossaryPassportTitle": "Hộ chiếu Wold",
  "glossaryPassportBody": "Một bản lý lịch có ký, có thể xác minh ngoại tuyến. Người khác không cần tin bất kỳ máy chủ nào — họ chỉ cần xác minh chữ ký.",
  "glossaryMigrationTitle": "Chuyển điện thoại (khôi phục danh tính)",
  "glossaryMigrationBody": "Chuyển danh tính sang điện thoại mới \"kèm bằng chứng\", sau đó danh tính trên điện thoại cũ thật sự ngừng hoạt động. Đây không phải sao chép khóa riêng — mà là luân chuyển khóa có bằng chứng, nên điện thoại cũ thật sự bị vô hiệu.",
  "glossaryRadarTitle": "Radar",
  "glossaryRadarBody": "Phát hiện người khác trên cùng một Wi-Fi qua Thiết bị lân cận (Bluetooth / Wi-Fi Direct). Nó không bao giờ đọc, lưu hay tải lên dữ liệu vị trí — Android xếp việc quét Bluetooth vào \"Vị trí\", và đó là quy tắc của hệ điều hành.",
  "glossaryRosterTitle": "Danh bạ bắt được",
  "glossaryRosterBody": "Danh bạ được xây từ những người radar phát hiện được hoặc bạn gặp trong phòng. Đây là điểm khởi đầu cho mọi mối quan hệ xã hội về sau.",
  "glossaryIntercardTitle": "Giới thiệu fen (liên kết xuyên vòng tròn)",
  "glossaryIntercardBody": "Một lời giới thiệu chính thức giữa hai fen, chỉ được tính khi cả hai bên xác nhận. Liên kết xuyên vòng tròn chỉ có thể mọc ra từ một phòng chung có thật — không bao giờ từ việc nhận quen ai đó qua ID.",
  "glossaryWorldTitle": "Thế giới / phòng khách",
  "glossaryWorldBody": "\"Thế giới\" là không gian đám mây công khai; một \"phòng khách\" là một phòng bên trong nó, gần giống một nhóm QQ: phòng chính thức mở cho mọi người, phòng cá nhân cần số phòng và sự phê duyệt. Khi người khác trò chuyện, fen của bạn mặc định chỉ quan sát và không chen vào.",
  "glossaryRoomRoleTitle": "Vai trò trong phòng",
  "glossaryRoomRoleBody": "Chủ phòng / đồng chủ phòng / khách / vai trò chức năng / người tham gia. Vai trò thuộc về phòng và không thay đổi danh tính bạn — cùng một bạn có thể giữ các vai trò khác nhau ở các phòng khác nhau.",
  "glossaryAutopilotTitle": "Tự động",
  "glossaryAutopilotBody": "Cho phép fen của bạn tự nói trong phòng khi bạn không nhìn màn hình, trong một hạn mức theo giờ. Mặc định tắt, và bạn có thể tắt bất cứ lúc nào.",
  "glossaryRepNetTitle": "Chứng thực mạng lưới",
  "glossaryRepNetBody": "Uy tín được bạn và bạn bè ký từng lớp, mà bạn có thể tự xác minh. Khi không tìm thấy đường nào, nó nói \"không biết\", không phải \"0\" — ai biến nó thành một con số xác định thì đang đoán mò.",
  "glossaryMemoryTitle": "Chưng cất ký ức",
  "glossaryMemoryBody": "Vào ban đêm, nó chưng cất các cuộc trò chuyện của bạn thành ký ức dài hạn và tinh chỉnh cách nó nói. Bạn có thể kích hoạt thủ công một lần trên trang Quản lý.",
  "glossaryProfileTitle": "Hồ sơ dài hạn",
  "glossaryProfileBody": "Những điều mà nhân bản của bạn dần hiểu về bạn: các chủ đề bạn hay quay lại và khung giờ bạn thường hoạt động. Chỉ được tính trên máy từ siêu dữ liệu sự kiện — không đọc nội dung trò chuyện, không tải lên đâu cả. Có thể tắt riêng trong \"Cài đặt → Trí nhớ\"; khi tắt công tắc tổng \"Tự động truy hồi\" thì hồ sơ cũng dừng theo.",
  "glossarySerendipityTitle": "Phòng thí nghiệm may mắn",
  "glossarySerendipityBody": "Một bộ bài tập nhỏ coi \"may mắn\" như một môn luyện: luyện tập buổi sáng, thử thách bứt phá vòng tròn, tái định khung thất bại, ghi chú le lói, nhật ký và bói toán. Hoàn thành chúng để nhận Lp (năng lượng may mắn).",
  "helpSkillMarketTitle": "Chợ kỹ năng: những thuật ngữ này nghĩa là gì?",
  "helpSkillMarketBody": "Phát hành = đưa một kỹ năng bạn viết lên chợ để fen của người khác dùng được. Phát hành ký nó bằng khóa riêng danh tính của thiết bị này — khóa không bao giờ rời thiết bị, và biểu mẫu không có ô nào để dán khóa công khai hay chữ ký, nên việc làm giả đơn giản là không thể diễn đạt trong giao diện.\n\nMức rủi ro (thấp / trung bình / cao) = sự tự khai của bạn về độ nhạy cảm của kỹ năng này (nó có lên mạng, mở ứng dụng khác, … không). Mức càng cao, bên gọi càng phải cấp nhiều hơn ở lần dùng đầu.\n\nKhai báo năng lực = danh sách chính xác các năng lực mà kỹ năng sẽ dùng. Cùng với mức rủi ro, đó là tất cả những gì bên gọi thấy khi quyết định có cho phép hay không.\n\nChia cho tác giả = doanh thu từ việc người khác dùng kỹ năng của bạn được ghi cho bạn; màn hình này chỉ cộng các mục được ký bằng khóa công khai của bạn, và tổng khớp từng mục với sổ cái.\n\nMục đã ký = mọi kỹ năng đều mang chữ ký, nên không ai phải tin máy chủ — hãy chạm Xác minh chữ ký và tự kiểm tra.",
  "helpSettingsRecallTitle": "Tự động truy hồi",
  "helpSettingsRecallBody": "Khi bật, trước mỗi câu trả lời, ứng dụng tìm trong ký ức cục bộ những sự việc quá khứ có thể liên quan và đưa cho fen làm ngữ cảnh. Tắt nó tiết kiệm chút tính toán và ngữ cảnh.",
  "helpIdentityRestoreTitle": "Khôi phục trên điện thoại mới",
  "helpIdentityRestoreBody": "Trên điện thoại mới, nhập ba thứ ở đây: mã khôi phục + cụm mật khẩu + ID người dùng của bạn. Ngay khi khôi phục thành công, điện thoại cũ ngừng hoạt động.\n\nĐây là luân chuyển khóa có bằng chứng (ROTATE), không phải sao chép khóa riêng sang — nên số danh tính giữ nguyên, nhưng thiết bị cũ không còn hợp lệ.",
  "helpIdentityArchiveTitle": "Tệp lưu trữ danh tính (tệp .dahuang)",
  "helpIdentityArchiveBody": "Tệp lưu trữ niêm phong bản ghi danh tính, đồ thị xã hội và các mỏ neo nhật ký của bạn vào một tệp .dahuang bằng cụm mật khẩu: nó không bao giờ đi qua máy chủ của chúng tôi, nên hãy giữ nó trong ổ đám mây hoặc USB của riêng bạn. Nó chỉ chứa dữ liệu — không bao giờ chứa khóa riêng danh tính.\n\nNếu có thể, hãy dùng cụm mật khẩu khác với mã khôi phục; giữ tệp và cụm mật khẩu tách rời — không có cụm mật khẩu thì không ai mở được tệp (kể cả chúng tôi).\n\nKhi nhập, không có gì được ghi cho đến khi bạn xác nhận; nhập chỉ thêm bản ghi, không bao giờ ghi đè hay xóa bản ghi hiện có.",
  "helpIdentityCodeTitle": "Sao chép mã khôi phục",
  "helpIdentityCodeBody": "Nhấn giữ để chọn tất cả và sao chép; nếu bạn chép tay, hãy kiểm tra từng đoạn.",
  "helpDeviceMigrationTitle": "Chuyển giữa hai điện thoại",
  "helpDeviceMigrationBody": "Cả hai điện thoại phải ở cùng một Wi-Fi và đang mở trang này.\n\nThứ được chuyển là danh tính: sau đó, nếu điện thoại này cần địa chỉ máy chủ, hãy kiểm tra Cài đặt — địa chỉ Hub và World không đổi.\n\nLịch sử trò chuyện và dữ liệu đã có trên điện thoại này không được chuyển (chuyển trực tiếp chỉ chuyển danh tính, không chuyển dữ liệu).",
  "helpRotationChainAuthorityTitle": "Kết luận nào mới đáng tin",
  "helpRotationChainAuthorityBody": "Cột Hub chỉ để so sánh — kết luận phía trên được tính ngay trên điện thoại này, từ những bản ghi bạn thực sự đang giữ.\n\nNói cách khác, kể cả Hub nói khác, bạn cũng không cần tin máy chủ; kết luận tính cục bộ mới là cái đáng tin.",
  "helpToolBusTitle": "Bus công cụ",
  "helpToolBusBody": "Mỗi công cụ/kỹ năng đều mang chữ ký thiết bị và khai báo năng lực; các năng lực rủi ro trung bình và cao cần được cấp quyền ở lần dùng đầu.\n\nPlugin bị sửa đổi không bao giờ tải — nếu kiểm tra thất bại, chúng đơn giản là không được gắn vào bus.",
